{
  "name": "dsh-annotated-browser",
  "version": "1.0.0",
  "type": "module",
  "description": "Annotation for the DSH sidebar browser: render pages through a same-origin host proxy, then click an element or drag a region and send the note into the conversation.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "dependencies": {
    "puppeteer-core": "^23.11.1"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "browser",
    "annotation",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KirinKylin-1/dsh-annotated-browser.git"
  },
  "homepage": "https://github.com/KirinKylin-1/dsh-annotated-browser#readme",
  "bugs": {
    "url": "https://github.com/KirinKylin-1/dsh-annotated-browser/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
